{
  "name": "@print-an-agent/base-identity-config",
  "version": "0.1.0",
  "description": "Stable Agent identity catalogs and storage-agnostic configuration contracts.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "test:coverage": "pnpm run build && vitest run --coverage --passWithNoTests",
    "typecheck": "pnpm run build && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../../../.prettierignore"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ttesjt/print-an-agent.git",
    "directory": "modules/agent-base/packages/identity-config"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
