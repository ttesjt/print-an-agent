{
  "name": "@ta-agent/base-integration-tests",
  "version": "0.1.0",
  "description": "Module-level Agent Base integration tests over public package exports.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ta-agent/context-memory": "workspace:*",
    "@ta-agent/context-memory-sqlite": "workspace:*",
    "@ta-agent/retrieval-memory": "workspace:*",
    "@ta-agent/retrieval-memory-sqlite": "workspace:*",
    "@ta-agent/model-invocation-token-counters": "workspace:*",
    "@ta-agent/workflow-bundle": "workspace:*",
    "@ta-agent/base-actor": "workspace:*",
    "@ta-agent/base-composition": "workspace:*",
    "@ta-agent/base-config": "workspace:*",
    "@ta-agent/base-identity": "workspace:*",
    "@ta-agent/base-local-adapters": "workspace:*",
    "@ta-agent/model-invocation-core": "workspace:*",
    "@ta-agent/base-observability": "workspace:*",
    "@ta-agent/base-request": "workspace:*",
    "@ta-agent/base-session": "workspace:*",
    "@ta-agent/base-standalone-agent": "workspace:*",
    "@ta-agent/base-tool": "workspace:*",
    "@ta-agent/base-runtime": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@ta-agent/model-invocation-pi": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  }
