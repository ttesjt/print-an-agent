{
  "name": "@print-an-agent/context-memory-sqlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite incremental immutable history, current snapshots and atomic receipts for Context Memory.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "typecheck": "pnpm run build && tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@print-an-agent/context-memory": "workspace:*"
  },
  "devDependencies": {
    "@print-an-agent/workflow-core": "workspace:*",
    "@print-an-agent/model-invocation-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
