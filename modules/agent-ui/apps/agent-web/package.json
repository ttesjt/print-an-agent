{
  "name": "@ta-agent/ui-agent-web",
  "version": "0.1.0",
  "description": "General-purpose Agent Web application composition root.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:dependencies && tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "build:dependencies": "pnpm --filter '@ta-agent/ui-agent-web^...' build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "pnpm run build:dependencies && vite",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "serve": "node dist/server/node/main.js"
  },
  "dependencies": {
    "@ta-agent/context-memory": "workspace:*",
    "@ta-agent/retrieval-memory": "workspace:*",
    "@ta-agent/workflow-core": "workspace:*",
    "@ta-agent/ui-workspace": "workspace:*",
    "@ta-agent/base-actor": "workspace:*",
    "@ta-agent/base-composition": "workspace:*",
    "@ta-agent/base-config": "workspace:*",
    "@ta-agent/base-identity": "workspace:*",
    "@ta-agent/base-local-adapters": "workspace:*",
    "@ta-agent/model-invocation-core": "workspace:*",
    "@ta-agent/base-request": "workspace:*",
    "@ta-agent/base-session": "workspace:*",
    "@ta-agent/base-standalone-agent": "workspace:*",
    "@ta-agent/base-tool": "workspace:*",
    "@ta-agent/ui-contracts": "workspace:*",
    "@ta-agent/ui-react": "workspace:*",
    "@ta-agent/ui-styles": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@ta-agent/ui-transport": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "20.14.5",
    "typescript": "catalog:",
    "vite": "7.3.2",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
