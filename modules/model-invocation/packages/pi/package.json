{
  "name": "@print-an-agent/model-invocation-pi",
  "version": "0.1.0",
  "description": "Independent Pi-backed Actor Engines and explicit provider configuration.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "typecheck": "pnpm run build && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../../../.prettierignore"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@print-an-agent/model-invocation-core": "workspace:*",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ttesjt/print-an-agent.git",
    "directory": "modules/model-invocation/packages/pi"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
