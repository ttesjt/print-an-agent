    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ta-agent/model-invocation-core": "workspace:*",
    "js-tiktoken": "1.0.21"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
