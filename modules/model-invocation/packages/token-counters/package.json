{
  "name": "@ta-agent/model-invocation-token-counters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional local text tokenizers and explicit token estimators.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "pnpm run build && tsc --noEmit",
