{
  "name": "@ta-agent/workbench-control-plane",
  "version": "0.1.0",
  "description": "Governed Model Workbench operations, queries, and dynamic asset acceptance.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "pnpm run build && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ta-agent/workbench-domain": "workspace:*",
    "@ta-agent/workbench-extension": "workspace:*",
    "@ta-agent/workbench-persistence": "workspace:*",
    "@ta-agent/workbench-setup": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
