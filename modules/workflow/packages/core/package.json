{
  "name": "@print-an-agent/workflow-core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Domain-independent, run-scoped Workflow and replaceable Step execution.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/bundle/index.d.ts",
      "import": "./dist/bundle/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "pnpm run build && tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ttesjt/print-an-agent.git",
    "directory": "modules/workflow/packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
