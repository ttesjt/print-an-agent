{
  "name": "pnpm-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "pnpm monorepo starter",
  "scripts": {
    "build": "pnpm -r build",
    "build:clean": "pnpm clean && pnpm install && pnpm -r build",
    "clean": "pnpm -r clean",
    "clean:all": "pnpm clean && find . -type d \\( -name 'node_modules' -o -name 'dist' \\) -exec rm -rf {} + -o -name '*.tsbuildinfo' -exec rm -rf {} +",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
