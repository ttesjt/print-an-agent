{
  "name": "modular-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "A modular framework for building agents with replaceable model, workflow, memory, and application components.",
  "scripts": {
    "build": "pnpm -r --if-present build && pnpm python:build",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write . && pnpm python:format",
    "format:check": "prettier --check . && pnpm python:format:check",
    "lint": "pnpm -r --if-present build && eslint . && pnpm python:lint",
    "lint:fix": "eslint . --fix && pnpm python:lint:fix",
    "test": "pnpm test:architecture && pnpm -r --if-present test && pnpm python:test",
    "test:architecture": "vitest run test/architecture.test.ts",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "typecheck": "pnpm -r --if-present typecheck && pnpm python:typecheck",
    "python:sync": "uv sync --project modules/model-workbench/python --all-packages",
    "python:build": "uv build modules/model-workbench/python/template --out-dir temp/python-template-dist",
    "python:format": "uv run --directory modules/model-workbench/python ruff format .",
    "python:format:check": "uv run --directory modules/model-workbench/python ruff format --check .",
    "python:lint": "uv run --directory modules/model-workbench/python ruff check .",
    "python:lint:fix": "uv run --directory modules/model-workbench/python ruff check --fix .",
    "python:typecheck": "uv run --directory modules/model-workbench/python mypy",
    "python:test": "uv run --directory modules/model-workbench/python pytest",
    "python:validate": "pnpm python:format:check && pnpm python:lint && pnpm python:typecheck && pnpm python:test && pnpm python:build",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.28.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
